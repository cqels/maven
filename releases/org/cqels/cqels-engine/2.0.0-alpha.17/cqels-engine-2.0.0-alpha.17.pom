<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.cqels</groupId>
    <artifactId>cqels-parent</artifactId>
    <version>2.0.0-alpha.17</version>
  </parent>
  <artifactId>cqels-engine</artifactId>
  <version>2.0.0-alpha.17</version>
  <name>CQELS Engine</name>
  <description>Stream processing engine implementation with SPARQL and CEP support</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
      <comments>See the LICENSE file at the repository root. Third-party dependency
                licenses are documented in THIRD-PARTY-NOTICES.md.</comments>
    </license>
  </licenses>
  <dependencies>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-storage-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-shacl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-asp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-queryalgebra-evaluation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-repository-sail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-sail-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-storage-lmdb</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-storage-rocksdb</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

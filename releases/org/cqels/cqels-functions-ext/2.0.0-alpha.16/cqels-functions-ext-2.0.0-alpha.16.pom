<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.cqels</groupId>
    <artifactId>cqels-parent</artifactId>
    <version>2.0.0-alpha.16</version>
  </parent>
  <artifactId>cqels-functions-ext</artifactId>
  <version>2.0.0-alpha.16</version>
  <name>CQELS Extension Functions</name>
  <description>Reference function plugin for the #531 extension-function seam: pure-Java SPARQL
        extension functions (urn:cqels:fn:levenshtein, urn:cqels:fn:haversine) registered through
        RDF4J's ServiceLoader-fed FunctionRegistry — drop the jar on the classpath and the
        functions resolve in CQELS-QL FILTER/BIND with zero CQELS registration code. Published
        (no maven.deploy.skip) so deployments can depend on it directly.</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
      <comments>See the LICENSE file at the repository root. Third-party dependency
                licenses are documented in THIRD-PARTY-NOTICES.md.</comments>
    </license>
  </licenses>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-queryalgebra-evaluation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

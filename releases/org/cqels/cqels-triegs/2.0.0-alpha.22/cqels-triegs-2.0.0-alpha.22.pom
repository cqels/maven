<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.cqels</groupId>
    <artifactId>cqels-parent</artifactId>
    <version>2.0.0-alpha.22</version>
  </parent>
  <artifactId>cqels-triegs</artifactId>
  <version>2.0.0-alpha.22</version>
  <name>CQELS TrieGS</name>
  <description>CQELS TrieGS — factorized incremental view maintenance for windowed joins</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
      <comments>See the LICENSE file at the repository root. Third-party dependency
                licenses are documented in THIRD-PARTY-NOTICES.md.</comments>
    </license>
  </licenses>
  <properties>
    <triegs.excludedGroups>triegs-exhaustive</triegs.excludedGroups>
    <triegs.reuseForks>true</triegs.reuseForks>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.cqels</groupId>
      <artifactId>cqels-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-model-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-model</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${triegs.excludedGroups}</excludedGroups>
          <reuseForks>${triegs.reuseForks}</reuseForks>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
